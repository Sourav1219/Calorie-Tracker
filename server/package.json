{
  "name": "pureintake-server",
  "version": "1.0.0",
  "description": "PureIntake calorie tracker — Express.js backend",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "seed": "node scripts/seedMongo.js",
    "seed:sample": "node scripts/seedSampleData.js",
    "migrate:pg-to-mongo": "node scripts/migratePostgresToMongo.js",
    "set-admin": "node scripts/setAdminRole.js",
    "sync:food-catalog": "node scripts/syncFoodCatalog.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "apicache": "^1.6.3",
    "axios": "^1.15.2",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.7.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.2",
    "morgan": "^1.10.1",
    "pg": "^8.16.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "nodemon": "^3.1.9",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "calorie",
    "tracker",
    "nutrition",
    "health"
  ],
  "author": "",
  "license": "MIT"
}
